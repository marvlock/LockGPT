{
  "manifest_version": 3,
  "name": "LockGPT",
  "version": "0.3.0",
  "description": "Hide your existing AI conversations while someone borrows your browser.",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lockgpt@marvlock.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LockGPT",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "js": [
        "assets/bootstrap.ts-loader-BXpYxxpn.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "css": [
        "src/content/guard.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "resources": [
        "assets/policy-BpedfX2M.js",
        "assets/bootstrap.ts-MwTk1Dxd.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
