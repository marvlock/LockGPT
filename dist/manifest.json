{
  "manifest_version": 3,
  "name": "LockGPT",
  "version": "0.1.0",
  "description": "Hide your existing ChatGPT conversations while someone borrows your browser.",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LockGPT",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "js": [
        "assets/bootstrap.ts-C4-C60h5.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "src/content/guard.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "resources": [
        "assets/bootstrap.ts-C4-C60h5.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
